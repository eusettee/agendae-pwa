# Vercel > Settings > Environment Variables. Credenciais apenas no backend.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Painel da unidade (padrão de demonstração: painel-demo)
PANEL_ACCESS_CODE=
# Chave para proteger o CPF (opcional; sem ela, deriva da chave Firebase)
CPF_SECRET=
# Links enviados pelo atendimento
APP_URL=https://agendae-pwa.vercel.app
# Opcional: gateway para n8n/outros canais (mínimo 24 caracteres)
GATEWAY_TOKEN=
# Opcional: WhatsApp Cloud API real (sem isso, use o simulador na tela Canais)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
