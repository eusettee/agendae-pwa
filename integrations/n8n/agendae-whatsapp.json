{
  "name": "Agendaê · Atendimento WhatsApp",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "agendae-chat", "responseMode": "responseNode", "options": {} },
      "id": "5b7f6a52-0d3e-4d47-9a51-3c1f2a6b0001",
      "name": "Mensagem do app (simulador)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "5b7f6a52-0d3e-4d47-9a51-3c1f2a6b0101"
    },
    {
      "parameters": {
        "jsCode": "// Normaliza a mensagem recebida do simulador do app.\nreturn $input.all().map(item => {\n  const body = item.json.body || {};\n  return { json: { channel: 'site', from: String(body.from || ''), text: String(body.text || '').slice(0, 1000) } };\n});"
      },
      "id": "5b7f6a52-0d3e-4d47-9a51-3c1f2a6b0002",
      "name": "Normalizar (app)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENDAE_API_URL }}/api/gateway",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "=Bearer {{ $env.AGENDAE_GATEWAY_TOKEN }}" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.channel, from: $json.from, text: $json.text }) }}",
        "options": { "timeout": 15000 }
      },
      "id": "5b7f6a52-0d3e-4d47-9a51-3c1f2a6b0003",
      "name": "API Agendaê · Gateway (app)",
