      "position": [480, 0]
    },
    {
      "parameters": { "respondWith": "firstIncomingItem", "options": {} },
      "id": "5b7f6a52-0d3e-4d47-9a51-3c1f2a6b0004",
      "name": "Responder ao app",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 0]
    },
    {
      "parameters": { "httpMethod": "GET", "path": "agendae-whatsapp", "responseMode": "responseNode", "options": {} },
      "id": "5b7f6a52-0d3e-4d47-9a51-3c1f2a6b0005",
      "name": "Verificação da Meta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
