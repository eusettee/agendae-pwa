{
  "expo": {
    "name": "Agendaê",
    "slug": "agendae-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agendae.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#e1f2eb"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.agendae.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "agendae",
    "plugins": [
      "expo-router"
    ]
  }
}
